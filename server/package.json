{
  "name": "recon-edge-ai-server",
  "version": "1.0.0",
  "description": "ReconEDGE AI Backend Server",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "generate:data": "node utils/dataGenerator/generateData.js",
    "reconcile:data": "node services/reconciliation/index.js",
    "analyze:data": "node services/analytics/index.js",
    "test": "node --test services/reconciliation/__tests__/*.test.js utils/dataGenerator/__tests__/*.test.js services/analytics/__tests__/*.test.js services/ai/__tests__/*.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
